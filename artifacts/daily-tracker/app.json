{
  "expo": {
    "name": "Daily Tracker",
    "slug": "daily-tracker",
    "version": "0.14.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daily-tracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.amanupadhyay.dailytracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D120F"
      },
      "versionCode": 14,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1DB954",
          "defaultChannel": "nudges"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Manrope-SemiBold.ttf",
            "./assets/fonts/Manrope-ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "Tracker",
              "label": "Daily Tracker",
              "description": "Up to three habits with one-tap logging. Pick them in Settings.",
              "minWidth": "110dp",
              "minHeight": "72dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget/preview.png"
            }
          ]
        }
      ],
      "./plugins/withHealthRationale",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "manifestQueries": {
              "package": [
                "com.google.android.apps.healthdata"
              ]
            }
          }
        }
      ],
      "./plugins/withBackupRules",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0D120F",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D120F"
    }
  }
}
